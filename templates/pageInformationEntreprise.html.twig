{% extends "base_template.html.twig" %} 

{% block title %} Information de l'entreprise {% endblock %}

{% block content %}
<div>

    <div class="row g-4">
        
        <!-- Information de l'entreprise -->
        <div class="col-7">
            
            <div class="card h-100">
                <!-- Logo Entreprise -->
                <div class="card-header">
                    <h4>Entreprise : {{ entreprise.nom }}</h4>
                    <img src="images/{{ entreprise.logo }}" alt="Logo" width="40" height="40">
                </div>

                <ul class="list-group list-group-flush">
                    <li class="list-group-item">Nom de l'entreprise: {{ entreprise.nom }}</li>
                    <li class="list-group-item">Description de l'offre : {{ entreprise.offre }}</li>

                    <!--Si l'utilisateur souhaite contacter l'entreprise, il clique et est renvoyé sur la page de discussion directement avec l'entreprise -->
                    <li class="list-group-item">Discuter avec l'entreprise :  
                        <a href="discussion.php?destinataire={{ entreprise.mail }}">Ouvrir la messagerie</a>
                    </li>
                </ul>

                <!-- Bouton candidater, s'il clique alors un message de confirmation est affiché et la candidature est enregistrée dand la BD -->
                <div class="card-body d-flex justify-content-center my-3">
                    <button type="button" id="boutonCandidater" class="btn-outline theme-primary">Candidater</button>
                </div>

                <!-- Message de confirmation, caché tant qu'on ne clique pas sur le btn graçe à display : none -->
                <div id="messageConfirmation" class="alert theme-success" role="alert" style="display: none;">
                    Votre candidature a bien été prise en compte ! 
                </div>
                
            </div>     
        </div>
    
        <div class="col-5 d-flex flex-column">
            <div class="text-center mb-3">
                <h5 class="mb-3">Localisation de l'entreprise</h5>
            </div>

            <!-- Affichage carte -->
            <div class="d-flex justify-content-center my-3">
                <img src="images/carte.jpg" alt="Carte Test" width="300" height="200">
            </div>

        <!-- Bouton Consulter les logements -->
            <button type="button" class="btn-solid theme-primary">Consulter les logements à proximité</button>


            <!-- Nombre d'événements + btn En savoir plus   -->
            <div class="card bg-light border-0" style="border-radius: 10px;">
                <div class="card-body">
                    <p class="mb-2">Nombre d'événements festifs aux alentours : <strong>XX</strong></p>
                    <button type="button" class="btn-solid theme-primary">En savoir plus</button>
                </div>
            </div>

        </div>
    </div>

</div>

    <!--  Script pour afficher le message quand le btn est cliqué  -->
    <script>
        document.getElementById('boutonCandidater').addEventListener('click', function () {
            //Affichage du message en changeant le style
            document.getElementById('messageConfirmation').style.display = 'block';
        });
    </script>


{% endblock %}