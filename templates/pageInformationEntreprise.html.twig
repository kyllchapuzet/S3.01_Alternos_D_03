{% extends "base_template.html.twig" %} 

{% block title %} Information de l'entreprise {% endblock %}

{% block content %}
<div>

    <div>
        <h4>Entreprise : {{ entreprise.nom }}</h4>
    </div>

    <div class="row">
        
        <!-- Information de l'entreprise -->
        <div class="col-md-7">
            
            <div class="card">
                <!-- Logo Entreprise -->
                <div class="card-header">
                    <h5>Fiche d'informations</h5>
                    <img src="images/{{ entreprise.logo }}" alt="Logo" width="40" height="40">
                </div>

                <ul class="list-group list-group-flush">
                    <li class="list-group-item">Nom de l'entreprise: {{ entreprise.nom }}</li>
                    <li class="list-group-item">Description de l'offre : {{ entreprise.offre }}</li>

                    <!--Si l'utilisateur souhaite contacter l'entreprise, il clique et est renvoyé sur la page de discussion directement avec l'entreprise -->
                    <li class="list-group-item">Discuter avec l'entreprise :  
                        <a href="discussion.php?destinataire={{ entreprise.mail }}">Ouvrir la messagerie</a>
                    </li>
                </ul>

                <!-- Bouton candidater, s'il clique alors un message de confirmation est affiché et la candidature est enregistrée dand la BD -->
                <div class="card-body">
                    <button type="button" id="boutonCandidater" class="btn btn-outline-primary">Candidater</button>
                </div>

                <!-- Message de confirmation, caché tant qu'on ne clique pas sur le btn graçe à display : none -->
                <div id="messageConfirmation" class="alert alert-success" role="alert" style="display: none;">
                    Votre candidature a bien été prise en compte ! 
                </div>

            </div>
        </div>

        <!--  Script pour afficher le massage quand le btn est cliqué  -->
        <script>
            document.getElementById('boutonCandidater').addEventListener('click', function () {
                //Affichage du message en changeant le style
                document.getElementById('messageConfirmation').style.display = 'block';
            });
        </script>
    </div>

</div>


{% endblock %}