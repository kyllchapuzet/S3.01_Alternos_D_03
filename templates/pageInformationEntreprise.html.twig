{% extends "base_template.html.twig" %} 

{% block title %} Information de l'entreprise {% endblock %}

{% block content %}
<!-- Charge la feuille de style CSS de Leaflet -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.3.1/dist/leaflet.css" />
<div>

    <div class="row g-4 pt-10">
        
        <!-- Information de l'entreprise -->
        <div class="col-7">
            
            <div class="card shadow-lg">
                <!-- Logo Entreprise -->
                <div class="card-header">
                    <img src="images/{{ entreprise.logo }}" alt="Banniere" class="w-100" style="height: 180px; object-fit: cover;">
                </div>

                <ul class="list-group list-group-flush border-0">
                    <li class="list-group-item"><strong>Nom de l'entreprise : </strong>{{ entreprise.nom }}</li>
                    <li class="list-group-item"><strong>Description de l'offre : </strong><br>{{ entreprise.description }}</li>

                    <!--Si l'utilisateur souhaite contacter l'entreprise, il clique et est renvoyé sur la page de discussion directement avec l'entreprise -->
                    <li class="list-group-item"><strong>Discuter avec l'entreprise :</strong>  
                        <a href="discussion.php?destinataire={{ entreprise.email }}">Ouvrir la messagerie</a>
                    </li>
                </ul>

                <!-- Bouton candidater, s'il clique alors un message de confirmation est affiché et la candidature est enregistrée dand la BD -->
                <div class="card-body text-center border-0">
                    <button type="button" id="boutonCandidater" class="btn-outline theme-primary mx-auto">Candidater</button>
                </div>

                <!-- Message de confirmation, caché tant qu'on ne clique pas sur le btn graçe à display : none -->
                    <div id="messageConfirmation" class="alert theme-success mx-auto mb-5" role="alert" style="display: none; width: fit-content;">
                        Votre candidature a bien été prise en compte ! 
                    </div>
               
                
            </div>     
        </div>
    
        <div class="col-5 d-flex flex-column">
            <div class="text-center mb-3">
                <h5 class="mb-3">Localisation de l'entreprise</h5>
            </div>

            <!-- Affichage Carte OpenStreetMap -->
            <div id="maCarte" class="my-3" style="height: 300px; width: 100%; border-radius: 8px;"></div>
 
        <!-- Bouton Consulter les logements -->
            <button type="button" class="btn-outline theme-primary mx-auto mt-3 mb-5">Consulter les logements à proximité</button>


            <!-- Nombre d'événements + btn En savoir plus   -->
            <div class="card bg-light shadow" style="border-radius: 10px;">
                <div class="card-body">
                    <p class="mb-2 text-center">Nombre d'événements festifs aux alentours : <strong>XX</strong></p>
                    <button type="button" class="btn-outline theme-primary mx-auto">En savoir plus</button>
                </div>
            </div>

        </div>
    </div>

</div>

    <!-- Charge la bibliothèque JavaScript de Leaflet (le moteur qui gère l'affichage interactif, le zoom et les marqueurs) -->
    <script src="https://unpkg.com/leaflet@1.3.1/dist/leaflet.js" integrity="sha512-/Nsx9X4HebavoBvEBuyp3I7od5tA0UzAxs+j83KgC8PU0kgB4XiK4Lfe4y4cgBtaRJQEIFCW+oC506aPT2L1zw==" crossorigin=""></script>

    <!-- Script de la carte et du bouton Candidater -->
    <script>
        // Récupération de la latitude et de la longitude de l'entreprise depuis la base de données
        var lat = {{ entreprise.Latitude ?: 46.6033 }}; // on récupère la latitude de l'entreprise, sinon on met une valeur par défaut (centre de la France)
        var lon = {{ entreprise.Longitude ?: 1.8883 }}; // on récupère la longitude de l'entreprise, sinon on met une valeur par défaut (centre de la France)
        var zoom = {{ entreprise.Latitude ? 14 : 5 }}; // on définit le niveau de zoom en fonction de la présence de la latitude
        var macarte = null;

        // Fonction d'initialisation de la carte
        function initMap() {
            // Crée la carte dans la div "maCarte" et centre la vue sur [lat, lon] avec un zoom de 5
            macarte = L.map('maCarte').setView([lat, lon], zoom);

            // Charge et affiche le fond de carte depuis OpenStreetMap France
            L.tileLayer('https://{s}.tile.openstreetmap.fr/osmfr/{z}/{x}/{y}.png', {
                attribution: 'données © OpenStreetMap/ODbL - rendu OSM France',
                minZoom: 1,
                maxZoom: 20
            }).addTo(macarte);

            // Ajoute un marqueur sur la carte et affiche le nom de l'entreprise au clic
            var marker = L.marker([lat, lon]).addTo(macarte);
            marker.bindPopup("{{ entreprise.nom|e('js') }}");
        }

        // Exécution au chargement de la page
        window.onload = function() {
            initMap();

            //Script pour afficher le message quand le btn est cliqué
            document.getElementById('boutonCandidater').addEventListener('click', function () {
                //Affichage du message en changeant le style
                document.getElementById('messageConfirmation').style.display = 'block';
            });
        };
    </script>


{% endblock %}