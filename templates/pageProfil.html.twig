{% extends "base_template.html.twig" %} 

{% block title %} Profil {% endblock %}
{% block content %}

<div class="card m-5">
  <div class="card-body">
    Bienvenue {{ user.prenom }}, Vous pouvez consulter vos informations personnelles et gérer vos paramètres ici.
  </div>
</div>

<ul class="nav nav-pills" id="pills-tab" role="tablist">
  <li class="nav-item" role="presentation">
    <button class="nav-link active" id="pills-compte-tab" data-bs-toggle="tab" data-bs-target="#pills-home" type="button" role="tab" aria-controls="pills-home" aria-selected="true">Mes Informations</button>
  </li>
  <li class="nav-item" role="presentation">
    <button class="nav-link" id="pills-cv-tab" data-bs-toggle="tab" data-bs-target="#pills-cv" type="button" role="tab" aria-controls="pills-cv" aria-selected="false">Mon CV</button>
  </li>
  <li class="nav-item" role="presentation">
    <button class="nav-link" id="pills-pref-tab" data-bs-toggle="tab" data-bs-target="#pills-pref" type="button" role="tab" aria-controls="pills-pref" aria-selected="false">Préférences</button>
  </li>
</ul>
<div class="tab-content" id="pills-tabContent">
  <div class="tab-pane show active" id="pills-home" role="tabpanel" aria-labelledby="pills-compte-tab" tabindex="0">
    <div class="card m-5">
      <div class="card-body">
        <strong> Mon Compte <span class="badge theme-primary">Etudiant</span> </strong>
        <ul>
          <li class=""><strong>Nom :</strong> {{ user.nom }} </li>
          <li><strong>Prénom :</strong> {{ user.prenom }}</li>
          <li><strong>Adresse mail :</strong> {{ user.email }} </li>
          <li><strong>Numéro de téléphone :</strong> {{ user.numTel }} </li>
          <li><strong>Adresse :</strong> {{ user.adresse }} </li>
        </ul>
        <a href="#" class="btn btn-primary">✎ Modifier mes informations</a>
      </div>
    </div>
  </div>


  <div class="tab-pane" id="pills-cv" role="tabpanel" aria-labelledby="pills-cv-tab" tabindex="0">
    <div class="card m-5">
      <div class="card-body">
        <h3>Mon CV</h3>
          <img src="images/cvTest.png" alt="" width="1000"  height="1000">
      </div>
    </div>
  </div>

<div class="tab-pane" id="pills-pref" role="tabpanel" aria-labelledby="pills-pref-tab" tabindex="0">
    <div class="card m-5">
      <div class="card-body">
        <h3>Préférences</h3>
      </div>
    </div>
  </div>
</div>


</div>

