{% extends "base_template.html.twig" %} 

{% block title %} Profil {% endblock %}
{% block content %}

<div class="card m-5">
  <div class="card-body">
    Bienvenue {{ user.prenom }}, Vous pouvez consulter vos informations personnelles et gérer vos paramètres ici.
  </div>
</div>

<ul class="nav nav-pills" id="pills-tab" role="tablist">
  <li class="nav-item" role="presentation">
    <button class="nav-link active" id="pills-compte-tab" data-bs-toggle="tab" data-bs-target="#pills-home" type="button" role="tab" aria-controls="pills-home" aria-selected="true">Mes Informations</button>
  </li>
  <li class="nav-item" role="presentation">
    <button class="nav-link" id="pills-cv-tab" data-bs-toggle="tab" data-bs-target="#pills-cv" type="button" role="tab" aria-controls="pills-cv" aria-selected="false">Mon CV</button>
  </li>
  <li class="nav-item" role="presentation">
    <button class="nav-link" id="pills-pref-tab" data-bs-toggle="tab" data-bs-target="#pills-pref" type="button" role="tab" aria-controls="pills-pref" aria-selected="false">Préférences</button>
  </li>
</ul>
<div class="tab-content" id="pills-tabContent">
  <div class="tab-pane show active" id="pills-home" role="tabpanel" aria-labelledby="pills-compte-tab" tabindex="0">
    <div class="card m-5">
      <div class="card-body">
        <strong> Mon Compte <span class="badge theme-primary">Etudiant</span> </strong>
        <ul>
          <li class=""><strong>Nom :</strong> {% if modif == 'nom' %} <input type="text" name="nom" id="nom" placeholder="{{ user.nom }} "> <a href="pageProfil.php?modif=confirmNom" class="btn">✓</a> {% else %} {{ user.nom }} <a href="pageProfil.php?modif=nom" class="btn">✎</a> {% endif %} </li> 
          <li><strong>Prénom :</strong> {% if modif == 'prenom' %} <input type="text" name="prenom" id="prenom" placeholder="{{ user.prenom }} "> <a href="pageProfil.php?modif=confirmPrenom" class="btn">✓</a> {% else %} {{ user.prenom }} <a href="pageProfil.php?modif=prenom" class="btn">✎</a>{% endif %}</li>
          <li><strong>Adresse mail :</strong> {% if modif == 'email' %} <input type="email" name="email" id="email" placeholder="{{ user.email }} "> <a href="pageProfil.php?modif=confirmEmail" class="btn">✓</a> {% else %} {{ user.email }}  <a href="pageProfil.php?modif=email" class="btn">✎</a>{% endif %}</li>
          <li><strong>Numéro de téléphone :</strong> {% if modif == 'tel' %} <input type="tel" name="numTel" id="numTel" placeholder="{{ user.numTel }} "> <a href="pageProfil.php?modif=confirmNumTel" class="btn">✓</a> {% else %} {{ user.numTel }} <a href="pageProfil.php?modif=tel" class="btn">✎</a>{% endif %}</li>
          <li><strong>Adresse :</strong> {% if modif == 'adresse' %} <input type="text" name="adresse" id="adresse" placeholder="{{ user.adresse }} "> <a href="pageProfil.php?modif=confirmAdresse" class="btn">✓</a> {% else %} {{ user.adresse }} <a href="pageProfil.php?modif=adresse" class="btn">✎</a> {% endif %}</li>
        </ul>
      </div>
    </div>
  </div>


  <div class="tab-pane" id="pills-cv" role="tabpanel" aria-labelledby="pills-cv-tab" tabindex="0">
    <div class="card m-5">
      <div class="card-body">
        <h3>Mon CV</h3>
          <img src="images/cvTest.png" alt="" width="1000"  height="1000">
      </div>
    </div>
  </div>

<div class="tab-pane" id="pills-pref" role="tabpanel" aria-labelledby="pills-pref-tab" tabindex="0">
    <div class="card m-5">
      <div class="card-body">
        <h3>Préférences</h3>
      </div>
    </div>
  </div>
</div>


</div>

