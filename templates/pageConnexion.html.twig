{% extends "base_template.html.twig" %} 


{% block title %} Page de connexion {% endblock %}

{% block content %}

    {% if successMessage is not null %}
        <br>
        <div class="alert alert-success align-items-center justify-content-center" role="alert">
            {{ successMessage }}
        </div>
    {% endif %}

    <div class="container min-vh-100 d-flex align-items-center justify-content-center">
        <div class="card shadow-lg border-0 rounded-4 w-100" style="max-width: 430px;">
            <div class="card-body border p-4 p-md-5">
                <a class="" href="pageConnexion.php?retour=1">Retour</a>
                <div class="text-center shadow-sm mb-4">
                    <h2 class="fw-bold mb-2">Connexion</h2>
                    <p class="text-muted mb-0">Bienvenue sur votre espace Alternos</p>
                </div>
    
                {% if statut %}

                    <form method="post" action="login.php">
                        <div class="mb-3">
                            <label for="login" class="form-label fw-semibold">Adresse mail</label>
                            <input type="mail" class="form-control form-control-lg rounded-3" id="login" name="login" placeholder="Entrez votre adresse mail" required>
                        </div>

                        <div class="mb-3">
                            <label for="pwd" class="form-label fw-semibold">Mot de passe</label>
                            <input type="password" class="form-control form-control-lg rounded-3" id="pwd" name="pwd" placeholder="Entrez votre mot de passe" required>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <p> Vous n'avez pas de compte ? <a href="pageCreationDeCompte.php" class="text-decoration-none small">Créer un compte</a> </p>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100 rounded-3">Se connecter</button>
                    </form>
                {% else %}
                    <form method="post" action="pageConnexion.php">
                        <div class="choix justify-content text-center mb-3">
                            <div class="d-grid gap-2">
                                <button class="btn-solid theme-primary" type="submit" name="statut" value="etudiant">J'ai un compte étudiant</button>
                                <button class="btn-solid theme-accent" type="submit" name="statut" value="entreprise">J'ai un compte entreprise</button>
                            </div>
                        </div>
                    </form>
                    

                {% endif %}
                
            </div>
        </div>
    </div>

{% endblock %}
