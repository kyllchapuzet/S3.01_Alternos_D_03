{% extends "base_template.html.twig" %} 

{% block title %} Créer un compte {% endblock %}

{% block content %}

            {% if erreur is not null %}
                <br>
                <div class="alert alert-danger align-items-center justify-content-center" role="alert" >
                    {{ erreur }}
                </div>
            {% endif %}



{% if statut %}
        <div class="container min-vh-100 d-flex align-items-center justify-content-center">
    
        <div class="card shadow-lg border-0 rounded-4 w-100" style="max-width: 430px;">
        
            <div class="border card-body p-4 p-md-5">
                <a class="" href="pageCreationDeCompte.php?retour=1"><img src="images/retour.png" height="20" width="20"></a>
                <div class="text-center mb-4">  
                    <h2 class="fw-bold mb-2">Créer un compte <br> <span class="badge {% if statut === 'etudiant' %} theme-primary {% elseif statut === 'entreprise' %} theme-accent {% endif %}">{{ statut }}</span></h2>
                </div>

                <hr>
            <div class="contains-inline">
                <ol class="stepper sm:stepper-horizontal">
                    <li class="stepper-item active">Choix du type de compte</li>
                    <li class="stepper-item active">Création du compte</li>
                    <li class="stepper-item ">Infos personnelles</li>
                    <li class="stepper-item">Terminé</li>
                </ol>
            </div>

            <hr>

            <form method="post" action="creerUnCompte.php">
                <div class="mb-3">
                    <label for="login" class="form-label fw-semibold">Adresse mail</label>
                    <input type="email" class="form-control form-control-lg rounded-3" id="login" name="login" placeholder="Entrez votre adresse mail" required>
                </div>

                <div class="mb-3">
                    <label for="pwd" class="form-label fw-semibold">Mot de passe</label>
                    <input type="password" class="form-control form-control-lg rounded-3" id="pwd" name="pwd" placeholder="Entrez votre mot de passe" required>
                    <div class="strength" data-bs-strength>
                        <div class="strength-segment"></div>
                        <div class="strength-segment"></div>
                        <div class="strength-segment"></div>
                        <div class="strength-segment"></div>
                    </div>
                    <span class="strength-text"></span>
                </div>

                <div class="mb-3">
                    <label for="pwdConfirm" class="form-label fw-semibold">Confirmer le mot de passe</label>
                    <input type="password" class="form-control form-control-lg rounded-3" id="pwdConfirm" name="pwdConfirm" placeholder="Entrez à nouveau votre mot de passe" required>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <p> Vous avez déjà un compte ? <a href="pageConnexion.php" class="text-decoration-none small">Se connecter</a> </p>
                </div>

                <button type="submit" class="btn btn-primary btn-lg w-100 rounded-3">Créer un compte</button>
            </form>

{% else %}

        <div class="container min-vh-100 d-flex align-items-center justify-content-center">
    
        <div class="card shadow-lg border-0 rounded-4 w-100" style="max-width: 430px;">
        
            <div class="border card-body p-4 p-md-5">
                <div class="text-center mb-4">
                    <h2 class="fw-bold mb-2">Créer un compte</h2>
                </div>
            <hr>

            <div class="contains-inline">
                <ol class="stepper sm:stepper-horizontal">
                    <li class="stepper-item active">Choix du type de compte</li>
                    <li class="stepper-item ">Création du compte</li>
                    <li class="stepper-item ">Infos personnelles</li>
                    <li class="stepper-item">Terminé</li>
                </ol>
            </div>

            <hr>
            <form method="post" action="pageCreationDeCompte.php">
                <div class="choix justify-content text-center mb-3">
                    <div class="d-grid gap-2">
                        <button class="btn-solid theme-primary" type="submit" name="statut" value="etudiant">Créer un compte étudiant</button>
                        <button class="btn-solid theme-accent" type="submit" name="statut" value="entreprise">Créer un compte entreprise</button>
                    </div>
                </div>
            </form>

{% endif %}


        </div>
    </div>
</div>

{% endblock %}