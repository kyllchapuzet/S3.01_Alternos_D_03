{% extends "base_template.html.twig" %}

{% block content %}
  <div class="container my-4">
    <div class="row g-3">

      <!-- historique discussion-->
      <aside class="col-3">
        <div class="card shadow-sm h-100">
          <div class="card-header bg-primary text-white">Discussions</div>
          <!-- defilement-->
          <div class="list-group list-group-flush overflow-y-auto" style="max-height: 400px;">

            {% for conv in conversations %}
              <a
                href="messagerie.php?mail={{ conv.mail }}"
                class="list-group-item list-group-item-action {{ conv.mail == mail_choisi ? 'active' : '' }}"
              >
                {{ conv.nom }}
              </a>
            {% else %}
              <div class="list-group-item text-muted">Aucune discussion.</div>
            {% endfor %}

          </div>
        </div>
      </aside>

      <!-- Message -->
      <main class="col-9">
        <div class="card shadow-sm h-100">

          <!-- Titre -->
          <div class="card-header bg-white">
            Discussion avec <strong>{{ destinataire_nom }}</strong>
          </div>

          <!-- Liste des messages -->
          <div class="card-body bg-light overflow-y-auto" style="height: 400px;" id="zone-messages">
            {% for msg in messages %}
              <!-- définir couleur des messages -->
              {% if msg.mailExpediteur == user_mail %}
                <!-- moi -->
                <div class="text-end mb-3">
                  <small class="text-muted">Moi • {{ msg.dateEnvoi|date('d/m/Y H:i') }}</small><br>
                  <span class="d-inline-block p-2 rounded bg-primary text-white">
                    {{ msg.Contenu }}
                  </span>
                </div>
              {% else %}
                <!-- destinataire -->
                <div class="text-start mb-3">
                  <small class="text-muted">{{ destinataire_nom }} • {{ msg.dateEnvoi|date('d/m/Y H:i') }}</small><br>
                  <span class="d-inline-block p-2 rounded bg-white border">
                    {{ msg.Contenu }}
                  </span>
                </div>
              {% endif %}

            {% else %}
              <p class="text-muted">Aucun message.</p>
            {% endfor %}
          </div>

          <!-- Formulaire d'envoi -->
          <div class="card-footer bg-white">
            <form method="POST" class="d-flex gap-2">
              <input type="hidden" name="mail_destinataire" value="{{ mail_choisi }}">
              <input type="text" name="message" class="form-control" placeholder="Écrivez votre message..." required>
              <button type="submit" class="btn btn-primary">Envoyer</button>
            </form>
          </div>

        </div>
      </main>

    </div>
  </div>
  <script>
  var zone = document.getElementById('zone-messages');
  if (zone) {
     zone.scrollTop = zone.scrollHeight; 
     } 
</script>
{% endblock %}
